#: src/indicator.js
msgid "Claude usage"
msgstr "Utilizzo di Claude"

#: src/indicator.js
msgid "Extra usage"
msgstr "Utilizzo extra"

#: src/indicator.js
msgid "Refresh"
msgstr "Aggiorna"

#: src/indicator.js
msgid "Settings"
msgstr "Impostazioni"

#. Shown in the top bar instead of the percentage: keep it short.
#: src/indicator.js
msgid "no login"
msgstr "non connesso"

#. Shown in the top bar instead of the percentage: keep it short.
#: src/indicator.js
msgid "expired"
msgstr "scaduto"

#: src/indicator.js
msgid "Updated just now"
msgstr "Aggiornato ora"

#: src/indicator.js
msgid "Updated {age} ago"
msgstr "Aggiornato {age} fa"

#: src/indicator.js
msgid "Fetching…"
msgstr "Recupero…"

#: src/indicator.js
msgid "Not fetched yet"
msgstr "Non ancora recuperato"

#: src/indicator.js
msgid "No Claude Code login found at {path}. Install Claude Code and run `claude` once to sign in."
msgstr "Nessun accesso a Claude Code trovato in {path}. Installa Claude Code ed esegui `claude` una volta per accedere."

#: src/indicator.js
msgid "The credentials file has no Claude login. Run `claude` in a terminal and sign in."
msgstr "Il file delle credenziali non contiene un accesso a Claude. Esegui `claude` in un terminale e accedi."

#: src/indicator.js
msgid "Claude Code login expired. Open Claude Code (run `claude` in a terminal) to renew it; the meter picks it up as soon as it does."
msgstr "L’accesso a Claude Code è scaduto. Apri Claude Code (esegui `claude` in un terminale) per rinnovarlo; l’indicatore lo rileva non appena succede."

#: src/indicator.js
msgid "The usage API allows only a few calls per few minutes per account, shared with Claude Code. Next try in {left}."
msgstr "L’API di utilizzo consente solo poche chiamate ogni pochi minuti per account, condivise con Claude Code. Prossimo tentativo tra {left}."

#. Ends "Next try in {left}." when the wait is under a minute.
#: src/indicator.js
msgid "a moment"
msgstr "un momento"

#: src/indicator.js
msgid "Network error: {message}"
msgstr "Errore di rete: {message}"

#: src/indicator.js
msgid "Could not fetch usage: {message}"
msgstr "Impossibile recuperare l’utilizzo: {message}"

#: src/meter.js
msgid "Limit reached"
msgstr "Limite raggiunto"

#: src/meter.js
msgid "Limit reached, resets in {left} ({clock})"
msgstr "Limite raggiunto, si azzera tra {left} ({clock})"

#: src/meter.js
msgid "Resets in {left} ({clock})"
msgstr "Si azzera tra {left} ({clock})"

#: src/prefs.js
msgid "Percentage"
msgstr "Percentuale"

#: src/prefs.js
msgid "Small bar"
msgstr "Barra piccola"

#: src/prefs.js
msgid "Percentage and bar"
msgstr "Percentuale e barra"

#: src/prefs.js
msgid "Language"
msgstr "Lingua"

#: src/prefs.js
msgid "Automatic follows the system language, or English when there is no translation for it."
msgstr "«Automatica» segue la lingua del sistema, o l’inglese se non esiste una traduzione."

#: src/prefs.js
msgid "Automatic"
msgstr "Automatica"

#: src/prefs.js
msgid "Top bar"
msgstr "Barra superiore"

#: src/prefs.js
msgid "Show"
msgstr "Mostra"

#: src/prefs.js
msgid "What the 5-hour window looks like in the bar"
msgstr "Come appare la finestra di 5 ore nella barra"

#: src/prefs.js
msgid "Show icon"
msgstr "Mostra l’icona"

#: src/prefs.js
msgid "Also show the weekly percentage"
msgstr "Mostra anche la percentuale settimanale"

#: src/prefs.js
msgid "Shown after the 5-hour one, e.g. \"12% · 40%\""
msgstr "Mostrata dopo quella delle 5 ore, ad es. «12% · 40%»"

#: src/prefs.js
msgid "Position"
msgstr "Posizione"

#: src/prefs.js
msgid "0 is the leftmost slot of the right-hand cluster, next to app indicators"
msgstr "0 è la posizione più a sinistra del gruppo di destra, accanto agli indicatori delle applicazioni"

#: src/prefs.js
msgid "Colors"
msgstr "Colori"

#: src/prefs.js
msgid "Percentages from which the indicator changes color"
msgstr "Percentuali da cui l’indicatore cambia colore"

#: src/prefs.js
msgid "Amber from"
msgstr "Arancione da"

#: src/prefs.js
msgid "Red from"
msgstr "Rosso da"

#: src/prefs.js
msgid "Data"
msgstr "Dati"

#: src/prefs.js
msgid "Refresh every (seconds)"
msgstr "Intervallo di aggiornamento (secondi)"

#: src/prefs.js
msgid "The usage API allows only a few calls per few minutes, shared with Claude Code"
msgstr "L’API di utilizzo consente solo poche chiamate ogni pochi minuti, condivise con Claude Code"

#: src/prefs.js
msgid "Claude Code credentials file"
msgstr "File delle credenziali di Claude Code"

#: src/prefs.js
msgid "Leave empty for ~/.claude/.credentials.json"
msgstr "Lascia vuoto per ~/.claude/.credentials.json"

#: src/prefs.js
msgid "The file Claude Code writes when you sign in. Only the access token is read; nothing is written."
msgstr "Il file che Claude Code scrive quando accedi. Viene letto solo il token di accesso; non viene scritto nulla."

#. Short day names, before the clock time of a reset ("Wed 06:00").
#: src/usage.js
msgid "Mon"
msgstr "lun"

#: src/usage.js
msgid "Tue"
msgstr "mar"

#: src/usage.js
msgid "Wed"
msgstr "mer"

#: src/usage.js
msgid "Thu"
msgstr "gio"

#: src/usage.js
msgid "Fri"
msgstr "ven"

#: src/usage.js
msgid "Sat"
msgstr "sab"

#: src/usage.js
msgid "Sun"
msgstr "dom"

#: src/usage.js
msgid "5-hour window"
msgstr "Finestra di 5 ore"

#: src/usage.js
msgid "Weekly, all models"
msgstr "Settimanale, tutti i modelli"

#: src/usage.js
msgid "Weekly, apps"
msgstr "Settimanale, app"

#. A per-model weekly limit whose model the API does not name.
#: src/usage.js
msgid "Weekly, scoped"
msgstr "Settimanale, altro"

#. {scope} is a model or product name from the API, e.g. "Fable".
#: src/usage.js
msgid "Weekly, {scope}"
msgstr "Settimanale, {scope}"

#. Durations, shown in the top bar: keep them short. {m} is zero-padded after hours ("2h 05m").
#: src/usage.js
msgid "{m}m"
msgstr "{m} min"

#. Durations, shown in the top bar: keep them short. {m} is zero-padded after hours ("2h 05m").
#: src/usage.js
msgid "{h}h {m}m"
msgstr "{h} h {m} min"

#. Durations, shown in the top bar: keep them short.
#: src/usage.js
msgid "{d}d {h}h"
msgstr "{d} g {h} h"
