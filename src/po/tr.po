#: src/indicator.js
msgid "Claude usage"
msgstr "Claude kullanımı"

#: src/indicator.js
msgid "Extra usage"
msgstr "Ek kullanım"

#: src/indicator.js
msgid "Refresh"
msgstr "Yenile"

#: src/indicator.js
msgid "Settings"
msgstr "Ayarlar"

#. Shown in the top bar instead of the percentage: keep it short.
#: src/indicator.js
msgid "no login"
msgstr "oturum yok"

#. Shown in the top bar instead of the percentage: keep it short.
#: src/indicator.js
msgid "expired"
msgstr "süresi doldu"

#: src/indicator.js
msgid "Updated just now"
msgstr "Az önce güncellendi"

#: src/indicator.js
msgid "Updated {age} ago"
msgstr "{age} önce güncellendi"

#: src/indicator.js
msgid "Fetching…"
msgstr "Alınıyor…"

#: src/indicator.js
msgid "Not fetched yet"
msgstr "Henüz alınmadı"

#: src/indicator.js
msgid "No Claude Code login found at {path}. Install Claude Code and run `claude` once to sign in."
msgstr "{path} konumunda Claude Code oturumu bulunamadı. Claude Code’u kurun ve oturum açmak için bir kez `claude` komutunu çalıştırın."

#: src/indicator.js
msgid "The credentials file has no Claude login. Run `claude` in a terminal and sign in."
msgstr "Kimlik bilgileri dosyasında Claude oturumu yok. Bir terminalde `claude` komutunu çalıştırıp oturum açın."

#: src/indicator.js
msgid "Claude Code login expired. Open Claude Code (run `claude` in a terminal) to renew it; the meter picks it up as soon as it does."
msgstr "Claude Code oturumunun süresi doldu. Yenilemek için Claude Code’u açın (terminalde `claude` komutunu çalıştırın); gösterge bunu hemen fark eder."

#: src/indicator.js
msgid "The usage API allows only a few calls per few minutes per account, shared with Claude Code. Next try in {left}."
msgstr "Kullanım API’si hesap başına birkaç dakikada yalnızca birkaç çağrıya izin veriyor ve bu sınır Claude Code ile ortak. {left} sonra yeniden denenecek."

#. Ends "Next try in {left}." when the wait is under a minute.
#: src/indicator.js
msgid "a moment"
msgstr "kısa bir süre"

#: src/indicator.js
msgid "Network error: {message}"
msgstr "Ağ hatası: {message}"

#: src/indicator.js
msgid "Could not fetch usage: {message}"
msgstr "Kullanım bilgisi alınamadı: {message}"

#: src/meter.js
msgid "Limit reached"
msgstr "Sınıra ulaşıldı"

#: src/meter.js
msgid "Limit reached, resets in {left} ({clock})"
msgstr "Sınıra ulaşıldı, {left} sonra sıfırlanacak ({clock})"

#: src/meter.js
msgid "Resets in {left} ({clock})"
msgstr "{left} sonra sıfırlanacak ({clock})"

#: src/prefs.js
msgid "Percentage"
msgstr "Yüzde"

#: src/prefs.js
msgid "Small bar"
msgstr "Küçük çubuk"

#: src/prefs.js
msgid "Percentage and bar"
msgstr "Yüzde ve çubuk"

#: src/prefs.js
msgid "Language"
msgstr "Dil"

#: src/prefs.js
msgid "Automatic follows the system language, or English when there is no translation for it."
msgstr "\"Otomatik\", sistem dilini kullanır; o dil için çeviri yoksa İngilizce gösterilir."

#: src/prefs.js
msgid "Automatic"
msgstr "Otomatik"

#: src/prefs.js
msgid "Top bar"
msgstr "Üst çubuk"

#: src/prefs.js
msgid "Show"
msgstr "Göster"

#: src/prefs.js
msgid "What the 5-hour window looks like in the bar"
msgstr "5 saatlik pencerenin çubukta nasıl görüneceği"

#: src/prefs.js
msgid "Show icon"
msgstr "Simgeyi göster"

#: src/prefs.js
msgid "Also show the weekly percentage"
msgstr "Haftalık yüzdeyi de göster"

#: src/prefs.js
msgid "Shown after the 5-hour one, e.g. \"12% · 40%\""
msgstr "5 saatlik yüzdeden sonra gösterilir, örneğin \"12% · 40%\""

#: src/prefs.js
msgid "Position"
msgstr "Konum"

#: src/prefs.js
msgid "0 is the leftmost slot of the right-hand cluster, next to app indicators"
msgstr "0, sağdaki grubun en solundaki yerdir; uygulama göstergelerinin hemen yanında"

#: src/prefs.js
msgid "Colors"
msgstr "Renkler"

#: src/prefs.js
msgid "Percentages from which the indicator changes color"
msgstr "Göstergenin renk değiştirdiği yüzdeler"

#: src/prefs.js
msgid "Amber from"
msgstr "Kehribar eşiği"

#: src/prefs.js
msgid "Red from"
msgstr "Kırmızı eşiği"

#: src/prefs.js
msgid "Data"
msgstr "Veri"

#: src/prefs.js
msgid "Refresh every (seconds)"
msgstr "Yenileme aralığı (saniye)"

#: src/prefs.js
msgid "The usage API allows only a few calls per few minutes, shared with Claude Code"
msgstr "Kullanım API’si birkaç dakikada yalnızca birkaç çağrıya izin veriyor ve bu sınır Claude Code ile ortak"

#: src/prefs.js
msgid "Claude Code credentials file"
msgstr "Claude Code kimlik bilgileri dosyası"

#: src/prefs.js
msgid "Leave empty for ~/.claude/.credentials.json"
msgstr "~/.claude/.credentials.json için boş bırakın"

#: src/prefs.js
msgid "The file Claude Code writes when you sign in. Only the access token is read; nothing is written."
msgstr "Claude Code’un oturum açtığınızda yazdığı dosya. Yalnızca erişim belirteci okunur; hiçbir şey yazılmaz."

#. Short day names, before the clock time of a reset ("Wed 06:00").
#: src/usage.js
msgid "Mon"
msgstr "Pzt"

#: src/usage.js
msgid "Tue"
msgstr "Sal"

#: src/usage.js
msgid "Wed"
msgstr "Çar"

#: src/usage.js
msgid "Thu"
msgstr "Per"

#: src/usage.js
msgid "Fri"
msgstr "Cum"

#: src/usage.js
msgid "Sat"
msgstr "Cmt"

#: src/usage.js
msgid "Sun"
msgstr "Paz"

#: src/usage.js
msgid "5-hour window"
msgstr "5 saatlik pencere"

#: src/usage.js
msgid "Weekly, all models"
msgstr "Haftalık, tüm modeller"

#: src/usage.js
msgid "Weekly, apps"
msgstr "Haftalık, uygulamalar"

#. A per-model weekly limit whose model the API does not name.
#: src/usage.js
msgid "Weekly, scoped"
msgstr "Haftalık, diğer"

#. {scope} is a model or product name from the API, e.g. "Fable".
#: src/usage.js
msgid "Weekly, {scope}"
msgstr "Haftalık, {scope}"

#. Durations, shown in the top bar: keep them short. {m} is zero-padded after hours ("2h 05m").
#: src/usage.js
msgid "{m}m"
msgstr "{m} dk"

#. Durations, shown in the top bar: keep them short. {m} is zero-padded after hours ("2h 05m").
#: src/usage.js
msgid "{h}h {m}m"
msgstr "{h} sa {m} dk"

#. Durations, shown in the top bar: keep them short.
#: src/usage.js
msgid "{d}d {h}h"
msgstr "{d} g {h} sa"
