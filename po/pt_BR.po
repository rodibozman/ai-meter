#: src/indicator.js
msgid "Claude usage"
msgstr "Uso do Claude"

#: src/indicator.js
msgid "Extra usage"
msgstr "Uso extra"

#: src/indicator.js
msgid "Refresh"
msgstr "Atualizar"

#: src/indicator.js
msgid "Settings"
msgstr "Configurações"

#. Shown in the top bar instead of the percentage: keep it short.
#: src/indicator.js
msgid "no login"
msgstr "sem login"

#. Shown in the top bar instead of the percentage: keep it short.
#: src/indicator.js
msgid "expired"
msgstr "expirado"

#: src/indicator.js
msgid "Updated just now"
msgstr "Atualizado agora mesmo"

#: src/indicator.js
msgid "Updated {age} ago"
msgstr "Atualizado há {age}"

#: src/indicator.js
msgid "Fetching…"
msgstr "Buscando…"

#: src/indicator.js
msgid "Not fetched yet"
msgstr "Ainda não buscado"

#: src/indicator.js
msgid "No Claude Code login found at {path}. Install Claude Code and run `claude` once to sign in."
msgstr "Nenhum login do Claude Code encontrado em {path}. Instale o Claude Code e execute `claude` uma vez para entrar."

#: src/indicator.js
msgid "The credentials file has no Claude login. Run `claude` in a terminal and sign in."
msgstr "O arquivo de credenciais não tem nenhum login do Claude. Execute `claude` em um terminal e entre na sua conta."

#: src/indicator.js
msgid "Claude Code login expired. Open Claude Code (run `claude` in a terminal) to renew it; the meter picks it up as soon as it does."
msgstr "O login do Claude Code expirou. Abra o Claude Code (execute `claude` em um terminal) para renová-lo; o medidor percebe assim que isso acontecer."

#: src/indicator.js
msgid "The usage API allows only a few calls per few minutes per account, shared with Claude Code. Next try in {left}."
msgstr "A API de uso só aceita algumas chamadas a cada poucos minutos por conta, e esse limite é compartilhado com o Claude Code. Nova tentativa em {left}."

#. Ends "Next try in {left}." when the wait is under a minute.
#: src/indicator.js
msgid "a moment"
msgstr "instantes"

#: src/indicator.js
msgid "Network error: {message}"
msgstr "Erro de rede: {message}"

#: src/indicator.js
msgid "Could not fetch usage: {message}"
msgstr "Não foi possível obter o uso: {message}"

#: src/meter.js
msgid "Limit reached"
msgstr "Limite atingido"

#: src/meter.js
msgid "Limit reached, resets in {left} ({clock})"
msgstr "Limite atingido, renova em {left} ({clock})"

#: src/meter.js
msgid "Resets in {left} ({clock})"
msgstr "Renova em {left} ({clock})"

#: src/prefs.js
msgid "Percentage"
msgstr "Porcentagem"

#: src/prefs.js
msgid "Small bar"
msgstr "Barra pequena"

#: src/prefs.js
msgid "Percentage and bar"
msgstr "Porcentagem e barra"

#: src/prefs.js
msgid "Language"
msgstr "Idioma"

#: src/prefs.js
msgid "Automatic follows the system language, or English when there is no translation for it."
msgstr "\"Automático\" segue o idioma do sistema, ou o inglês quando não há tradução para ele."

#: src/prefs.js
msgid "Automatic"
msgstr "Automático"

#: src/prefs.js
msgid "Top bar"
msgstr "Barra superior"

#: src/prefs.js
msgid "Show"
msgstr "Mostrar"

#: src/prefs.js
msgid "What the 5-hour window looks like in the bar"
msgstr "Como a janela de 5 horas aparece na barra"

#: src/prefs.js
msgid "Show icon"
msgstr "Mostrar ícone"

#: src/prefs.js
msgid "Also show the weekly percentage"
msgstr "Mostrar também a porcentagem semanal"

#: src/prefs.js
msgid "Shown after the 5-hour one, e.g. \"12% · 40%\""
msgstr "Aparece depois da de 5 horas, por exemplo \"12% · 40%\""

#: src/prefs.js
msgid "Position"
msgstr "Posição"

#: src/prefs.js
msgid "0 is the leftmost slot of the right-hand cluster, next to app indicators"
msgstr "0 é a posição mais à esquerda do grupo da direita, ao lado dos indicadores de aplicativos"

#: src/prefs.js
msgid "Colors"
msgstr "Cores"

#: src/prefs.js
msgid "Percentages from which the indicator changes color"
msgstr "Porcentagens a partir das quais o indicador muda de cor"

#: src/prefs.js
msgid "Amber from"
msgstr "Âmbar a partir de"

#: src/prefs.js
msgid "Red from"
msgstr "Vermelho a partir de"

#: src/prefs.js
msgid "Data"
msgstr "Dados"

#: src/prefs.js
msgid "Refresh every (seconds)"
msgstr "Atualizar a cada (segundos)"

#: src/prefs.js
msgid "The usage API allows only a few calls per few minutes, shared with Claude Code"
msgstr "A API de uso só aceita algumas chamadas a cada poucos minutos, e esse limite é compartilhado com o Claude Code"

#: src/prefs.js
msgid "Claude Code credentials file"
msgstr "Arquivo de credenciais do Claude Code"

#: src/prefs.js
msgid "Leave empty for ~/.claude/.credentials.json"
msgstr "Deixe vazio para usar ~/.claude/.credentials.json"

#: src/prefs.js
msgid "The file Claude Code writes when you sign in. Only the access token is read; nothing is written."
msgstr "O arquivo que o Claude Code grava quando você entra. Só o token de acesso é lido; nada é gravado."

#. Short day names, before the clock time of a reset ("Wed 06:00").
#: src/usage.js
msgid "Mon"
msgstr "seg."

#: src/usage.js
msgid "Tue"
msgstr "ter."

#: src/usage.js
msgid "Wed"
msgstr "qua."

#: src/usage.js
msgid "Thu"
msgstr "qui."

#: src/usage.js
msgid "Fri"
msgstr "sex."

#: src/usage.js
msgid "Sat"
msgstr "sáb."

#: src/usage.js
msgid "Sun"
msgstr "dom."

#: src/usage.js
msgid "5-hour window"
msgstr "Janela de 5 horas"

#: src/usage.js
msgid "Weekly, all models"
msgstr "Semanal, todos os modelos"

#: src/usage.js
msgid "Weekly, apps"
msgstr "Semanal, aplicativos"

#. A per-model weekly limit whose model the API does not name.
#: src/usage.js
msgid "Weekly, scoped"
msgstr "Semanal, outros"

#. {scope} is a model or product name from the API, e.g. "Fable".
#: src/usage.js
msgid "Weekly, {scope}"
msgstr "Semanal, {scope}"

#. Durations, shown in the top bar: keep them short. {m} is zero-padded after hours ("2h 05m").
#: src/usage.js
msgid "{m}m"
msgstr "{m} min"

#. Durations, shown in the top bar: keep them short. {m} is zero-padded after hours ("2h 05m").
#: src/usage.js
msgid "{h}h {m}m"
msgstr "{h} h {m} min"

#. Durations, shown in the top bar: keep them short.
#: src/usage.js
msgid "{d}d {h}h"
msgstr "{d} d {h} h"
