#: src/indicator.js
msgid "Claude usage"
msgstr "استخدام Claude"

#: src/indicator.js
msgid "Extra usage"
msgstr "الاستخدام الإضافي"

#: src/indicator.js
msgid "Refresh"
msgstr "تحديث"

#: src/indicator.js
msgid "Settings"
msgstr "الإعدادات"

#. Shown in the top bar instead of the percentage: keep it short.
#: src/indicator.js
msgid "no login"
msgstr "غير مسجَّل"

#. Shown in the top bar instead of the percentage: keep it short.
#: src/indicator.js
msgid "expired"
msgstr "منتهية"

#: src/indicator.js
msgid "Updated just now"
msgstr "تم التحديث للتو"

#: src/indicator.js
msgid "Updated {age} ago"
msgstr "تم التحديث قبل {age}"

#: src/indicator.js
msgid "Fetching…"
msgstr "جارٍ الجلب…"

#: src/indicator.js
msgid "Not fetched yet"
msgstr "لم يتم الجلب بعد"

#: src/indicator.js
msgid "No Claude Code login found at {path}. Install Claude Code and run `claude` once to sign in."
msgstr "لم يُعثر على تسجيل دخول إلى Claude Code في {path}. ثبّت Claude Code وشغّل `claude` مرة واحدة لتسجيل الدخول."

#: src/indicator.js
msgid "The credentials file has no Claude login. Run `claude` in a terminal and sign in."
msgstr "لا يحتوي ملف بيانات الاعتماد على تسجيل دخول إلى Claude. شغّل `claude` في الطرفية ثم سجّل الدخول."

#: src/indicator.js
msgid "Claude Code login expired. Open Claude Code (run `claude` in a terminal) to renew it; the meter picks it up as soon as it does."
msgstr "انتهت صلاحية تسجيل الدخول إلى Claude Code. افتح Claude Code (شغّل `claude` في الطرفية) لتجديده، وسيلتقطه المؤشر فور تجديده."

#: src/indicator.js
msgid "The usage API allows only a few calls per few minutes per account, shared with Claude Code. Next try in {left}."
msgstr "لا تسمح واجهة API الخاصة بالاستخدام إلا بعدد قليل من الطلبات كل بضع دقائق لكل حساب، وهذا الحد مشترك مع Claude Code. المحاولة التالية بعد {left}."

#. Ends "Next try in {left}." when the wait is under a minute.
#: src/indicator.js
msgid "a moment"
msgstr "لحظات"

#: src/indicator.js
msgid "Network error: {message}"
msgstr "خطأ في الشبكة: {message}"

#: src/indicator.js
msgid "Could not fetch usage: {message}"
msgstr "تعذّر جلب بيانات الاستخدام: {message}"

#: src/meter.js
msgid "Limit reached"
msgstr "تم بلوغ الحد"

#: src/meter.js
msgid "Limit reached, resets in {left} ({clock})"
msgstr "تم بلوغ الحد، يُعاد ضبطه بعد {left} ({clock})"

#: src/meter.js
msgid "Resets in {left} ({clock})"
msgstr "يُعاد ضبطه بعد {left} ({clock})"

#: src/prefs.js
msgid "Percentage"
msgstr "نسبة مئوية"

#: src/prefs.js
msgid "Small bar"
msgstr "شريط صغير"

#: src/prefs.js
msgid "Percentage and bar"
msgstr "نسبة مئوية وشريط"

#: src/prefs.js
msgid "Language"
msgstr "اللغة"

#: src/prefs.js
msgid "Automatic follows the system language, or English when there is no translation for it."
msgstr "يتّبع خيار «تلقائي» لغة النظام، أو الإنجليزية إذا لم تتوفر ترجمة لتلك اللغة."

#: src/prefs.js
msgid "Automatic"
msgstr "تلقائي"

#: src/prefs.js
msgid "Top bar"
msgstr "الشريط العلوي"

#: src/prefs.js
msgid "Show"
msgstr "العرض"

#: src/prefs.js
msgid "What the 5-hour window looks like in the bar"
msgstr "كيف تظهر نافذة الساعات الخمس في الشريط"

#: src/prefs.js
msgid "Show icon"
msgstr "إظهار الأيقونة"

#: src/prefs.js
msgid "Also show the weekly percentage"
msgstr "إظهار النسبة الأسبوعية أيضًا"

#: src/prefs.js
msgid "Shown after the 5-hour one, e.g. \"12% · 40%\""
msgstr "تظهر بعد نسبة الساعات الخمس، مثل «12% · 40%»"

#: src/prefs.js
msgid "Position"
msgstr "الموضع"

#: src/prefs.js
msgid "0 is the leftmost slot of the right-hand cluster, next to app indicators"
msgstr "0 هو أقصى موضع إلى اليسار في المجموعة اليمنى، بجوار مؤشرات التطبيقات"

#: src/prefs.js
msgid "Colors"
msgstr "الألوان"

#: src/prefs.js
msgid "Percentages from which the indicator changes color"
msgstr "النسب التي يتغير عندها لون المؤشر"

#: src/prefs.js
msgid "Amber from"
msgstr "الكهرماني ابتداءً من"

#: src/prefs.js
msgid "Red from"
msgstr "الأحمر ابتداءً من"

#: src/prefs.js
msgid "Data"
msgstr "البيانات"

#: src/prefs.js
msgid "Refresh every (seconds)"
msgstr "الفاصل الزمني للتحديث (بالثواني)"

#: src/prefs.js
msgid "The usage API allows only a few calls per few minutes, shared with Claude Code"
msgstr "لا تسمح واجهة API الخاصة بالاستخدام إلا بعدد قليل من الطلبات كل بضع دقائق، وهذا الحد مشترك مع Claude Code"

#: src/prefs.js
msgid "Claude Code credentials file"
msgstr "ملف بيانات اعتماد Claude Code"

#: src/prefs.js
msgid "Leave empty for ~/.claude/.credentials.json"
msgstr "اتركه فارغًا لاستخدام ~/.claude/.credentials.json"

#: src/prefs.js
msgid "The file Claude Code writes when you sign in. Only the access token is read; nothing is written."
msgstr "الملف الذي يكتبه Claude Code عند تسجيل الدخول. لا يُقرأ منه إلا رمز الوصول، ولا يُكتب فيه أي شيء."

#. Short day names, before the clock time of a reset ("Wed 06:00").
#: src/usage.js
msgid "Mon"
msgstr "الاثنين"

#: src/usage.js
msgid "Tue"
msgstr "الثلاثاء"

#: src/usage.js
msgid "Wed"
msgstr "الأربعاء"

#: src/usage.js
msgid "Thu"
msgstr "الخميس"

#: src/usage.js
msgid "Fri"
msgstr "الجمعة"

#: src/usage.js
msgid "Sat"
msgstr "السبت"

#: src/usage.js
msgid "Sun"
msgstr "الأحد"

#: src/usage.js
msgid "5-hour window"
msgstr "نافذة الساعات الخمس"

#: src/usage.js
msgid "Weekly, all models"
msgstr "أسبوعي، جميع النماذج"

#: src/usage.js
msgid "Weekly, apps"
msgstr "أسبوعي، التطبيقات"

#. A per-model weekly limit whose model the API does not name.
#: src/usage.js
msgid "Weekly, scoped"
msgstr "أسبوعي، أخرى"

#. {scope} is a model or product name from the API, e.g. "Fable".
#: src/usage.js
msgid "Weekly, {scope}"
msgstr "أسبوعي، {scope}"

#. Durations, shown in the top bar: keep them short. {m} is zero-padded after hours ("2h 05m").
#: src/usage.js
msgid "{m}m"
msgstr "{m} د"

#. Durations, shown in the top bar: keep them short. {m} is zero-padded after hours ("2h 05m").
#: src/usage.js
msgid "{h}h {m}m"
msgstr "{h} س {m} د"

#. Durations, shown in the top bar: keep them short.
#: src/usage.js
msgid "{d}d {h}h"
msgstr "{d} ي {h} س"
