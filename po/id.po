#: src/indicator.js
msgid "Claude usage"
msgstr "Penggunaan Claude"

#: src/indicator.js
msgid "Extra usage"
msgstr "Penggunaan tambahan"

#: src/indicator.js
msgid "Refresh"
msgstr "Muat ulang"

#: src/indicator.js
msgid "Settings"
msgstr "Pengaturan"

#. Shown in the top bar instead of the percentage: keep it short.
#: src/indicator.js
msgid "no login"
msgstr "belum login"

#. Shown in the top bar instead of the percentage: keep it short.
#: src/indicator.js
msgid "expired"
msgstr "kedaluwarsa"

#: src/indicator.js
msgid "Updated just now"
msgstr "Baru saja diperbarui"

#: src/indicator.js
msgid "Updated {age} ago"
msgstr "Diperbarui {age} yang lalu"

#: src/indicator.js
msgid "Fetching…"
msgstr "Mengambil data…"

#: src/indicator.js
msgid "Not fetched yet"
msgstr "Belum diambil"

#: src/indicator.js
msgid "No Claude Code login found at {path}. Install Claude Code and run `claude` once to sign in."
msgstr "Login Claude Code tidak ditemukan di {path}. Instal Claude Code, lalu jalankan `claude` sekali untuk masuk."

#: src/indicator.js
msgid "The credentials file has no Claude login. Run `claude` in a terminal and sign in."
msgstr "File kredensial tidak berisi login Claude. Jalankan `claude` di terminal, lalu masuk."

#: src/indicator.js
msgid "Claude Code login expired. Open Claude Code (run `claude` in a terminal) to renew it; the meter picks it up as soon as it does."
msgstr "Login Claude Code sudah kedaluwarsa. Buka Claude Code (jalankan `claude` di terminal) untuk memperbaruinya; meteran akan langsung mengenalinya begitu diperbarui."

#: src/indicator.js
msgid "The usage API allows only a few calls per few minutes per account, shared with Claude Code. Next try in {left}."
msgstr "API penggunaan hanya mengizinkan beberapa panggilan setiap beberapa menit per akun, dan batas ini dipakai bersama Claude Code. Dicoba lagi dalam {left}."

#. Ends "Next try in {left}." when the wait is under a minute.
#: src/indicator.js
msgid "a moment"
msgstr "beberapa saat"

#: src/indicator.js
msgid "Network error: {message}"
msgstr "Kesalahan jaringan: {message}"

#: src/indicator.js
msgid "Could not fetch usage: {message}"
msgstr "Gagal mengambil data penggunaan: {message}"

#: src/meter.js
msgid "Limit reached"
msgstr "Batas tercapai"

#: src/meter.js
msgid "Limit reached, resets in {left} ({clock})"
msgstr "Batas tercapai, direset dalam {left} ({clock})"

#: src/meter.js
msgid "Resets in {left} ({clock})"
msgstr "Direset dalam {left} ({clock})"

#: src/prefs.js
msgid "Percentage"
msgstr "Persentase"

#: src/prefs.js
msgid "Small bar"
msgstr "Bilah kecil"

#: src/prefs.js
msgid "Percentage and bar"
msgstr "Persentase dan bilah"

#: src/prefs.js
msgid "Language"
msgstr "Bahasa"

#: src/prefs.js
msgid "Automatic follows the system language, or English when there is no translation for it."
msgstr "\"Otomatis\" mengikuti bahasa sistem, atau bahasa Inggris jika belum ada terjemahan untuk bahasa itu."

#: src/prefs.js
msgid "Automatic"
msgstr "Otomatis"

#: src/prefs.js
msgid "Top bar"
msgstr "Bilah atas"

#: src/prefs.js
msgid "Show"
msgstr "Tampilkan"

#: src/prefs.js
msgid "What the 5-hour window looks like in the bar"
msgstr "Tampilan jendela 5 jam di bilah"

#: src/prefs.js
msgid "Show icon"
msgstr "Tampilkan ikon"

#: src/prefs.js
msgid "Also show the weekly percentage"
msgstr "Tampilkan juga persentase mingguan"

#: src/prefs.js
msgid "Shown after the 5-hour one, e.g. \"12% · 40%\""
msgstr "Muncul setelah persentase 5 jam, misalnya \"12% · 40%\""

#: src/prefs.js
msgid "Position"
msgstr "Posisi"

#: src/prefs.js
msgid "0 is the leftmost slot of the right-hand cluster, next to app indicators"
msgstr "0 adalah posisi paling kiri di kelompok kanan, tepat di sebelah indikator aplikasi"

#: src/prefs.js
msgid "Colors"
msgstr "Warna"

#: src/prefs.js
msgid "Percentages from which the indicator changes color"
msgstr "Persentase saat warna indikator berubah"

#: src/prefs.js
msgid "Amber from"
msgstr "Jingga mulai dari"

#: src/prefs.js
msgid "Red from"
msgstr "Merah mulai dari"

#: src/prefs.js
msgid "Data"
msgstr "Data"

#: src/prefs.js
msgid "Refresh every (seconds)"
msgstr "Muat ulang setiap (detik)"

#: src/prefs.js
msgid "The usage API allows only a few calls per few minutes, shared with Claude Code"
msgstr "API penggunaan hanya mengizinkan beberapa panggilan setiap beberapa menit, dan batas ini dipakai bersama Claude Code"

#: src/prefs.js
msgid "Claude Code credentials file"
msgstr "File kredensial Claude Code"

#: src/prefs.js
msgid "Leave empty for ~/.claude/.credentials.json"
msgstr "Kosongkan untuk memakai ~/.claude/.credentials.json"

#: src/prefs.js
msgid "The file Claude Code writes when you sign in. Only the access token is read; nothing is written."
msgstr "File yang ditulis Claude Code saat Anda masuk. Hanya token akses yang dibaca; tidak ada yang ditulis."

#. Short day names, before the clock time of a reset ("Wed 06:00").
#: src/usage.js
msgid "Mon"
msgstr "Sen"

#: src/usage.js
msgid "Tue"
msgstr "Sel"

#: src/usage.js
msgid "Wed"
msgstr "Rab"

#: src/usage.js
msgid "Thu"
msgstr "Kam"

#: src/usage.js
msgid "Fri"
msgstr "Jum"

#: src/usage.js
msgid "Sat"
msgstr "Sab"

#: src/usage.js
msgid "Sun"
msgstr "Min"

#: src/usage.js
msgid "5-hour window"
msgstr "Jendela 5 jam"

#: src/usage.js
msgid "Weekly, all models"
msgstr "Mingguan, semua model"

#: src/usage.js
msgid "Weekly, apps"
msgstr "Mingguan, aplikasi"

#. A per-model weekly limit whose model the API does not name.
#: src/usage.js
msgid "Weekly, scoped"
msgstr "Mingguan, lainnya"

#. {scope} is a model or product name from the API, e.g. "Fable".
#: src/usage.js
msgid "Weekly, {scope}"
msgstr "Mingguan, {scope}"

#. Durations, shown in the top bar: keep them short. {m} is zero-padded after hours ("2h 05m").
#: src/usage.js
msgid "{m}m"
msgstr "{m} mnt"

#. Durations, shown in the top bar: keep them short. {m} is zero-padded after hours ("2h 05m").
#: src/usage.js
msgid "{h}h {m}m"
msgstr "{h} j {m} mnt"

#. Durations, shown in the top bar: keep them short.
#: src/usage.js
msgid "{d}d {h}h"
msgstr "{d} hr {h} j"
